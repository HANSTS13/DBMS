SELECT DISTINCT C.*
FROM Customers1 C
JOIN Orders1 O ON C.CustId = O.CustId;
SELECT DISTINCT C.*
FROM Customers1 C
JOIN Delivery D ON C.CustId = D.CustId;
SELECT C.CustName, O.OrderDate
FROM Customers1 C
JOIN Orders1 O ON C.CustId = O.CustId
WHERE C.CustName LIKE 'J%';
SELECT I.ItemName, I.Price
FROM Items I
JOIN Orders1 O ON I.ItemId = O.ItemId
JOIN Customers1 C ON O.CustId = C.CustId
WHERE C.CustName = 'Mickey';

SELECT DISTINCT C.*
FROM Customers1 C
JOIN Orders1 O ON C.CustId = O.CustId
WHERE O.OrderDate > TO_DATE('01-JAN-2015','DD-MON-YYYY')
AND O.OrderId NOT IN (SELECT OrderId FROM Delivery);
SELECT ItemId FROM Orders1
UNION
SELECT ItemId
FROM Orders1
WHERE OrderId NOT IN (SELECT OrderId FROM Delivery);
